@startuml
!include <C4/C4_Container>

title Internet Banking System — Container View

Person(customer, "Personal Banking Customer", "A customer of the bank")

System_Boundary(banking, "Internet Banking System") {
  Container(spa, "Single-Page App", "JavaScript / React", "Browser UI")
  Container(api, "API Application", "Java / Spring", "Business logic")
  ContainerDb(db, "Database", "PostgreSQL", "Stores user accounts")
}

System_Ext(mainframe, "Mainframe Banking System", "Stores ledger")
System_Ext(email, "Email System", "Sends notifications")

Rel(customer, spa, "Uses", "HTTPS")
Rel(spa, api, "Makes API calls to", "JSON / HTTPS")
Rel(api, db, "Reads from / writes to", "JDBC")
Rel(api, mainframe, "Posts ledger events", "XML / SOAP")
Rel(api, email, "Sends emails using", "SMTP")
@enduml
