@startuml
!include <C4/C4_Context>

title Internet Banking System — System Context

Person(customer, "Personal Banking Customer", "A customer of the bank with personal accounts")

System_Boundary(bank, "Bank") {
  System(banking, "Internet Banking System", "Lets customers view balances and make payments")
}

System_Ext(mainframe, "Mainframe Banking System", "Stores all core banking ledger data")
System_Ext(email, "Email System", "Sends customer-facing notifications")

Rel(customer, banking, "Views account, makes payments")
Rel(banking, mainframe, "Reads from / writes to")
Rel(banking, email, "Sends emails using")
Rel(email, customer, "Sends emails to")
@enduml
