@startuml
title Class Diagram Example

interface Drawable {
  +draw()
  +bounds(): Rect
}

abstract class Shape {
  #color: String
  #strokeWidth: float
  +{abstract} area(): double
  +move(dx: int, dy: int)
}

class Circle {
  +radius: double
  +area(): double
}

class Square {
  +side: double
  +area(): double
}

class Triangle {
  +base: double
  +height: double
  +area(): double
}

class Polygon {
  -points: List<Point>
  +area(): double
}

class Canvas {
  -shapes: List<Shape>
  +add(s: Shape)
  +render()
}

Shape ..|> Drawable : implements
Circle --|> Shape : extends
Square --|> Shape : extends
Triangle --|> Shape : extends
Polygon --|> Shape : extends
Canvas "1" o-- "*" Shape : contains
Canvas ..> Circle : creates
@enduml
